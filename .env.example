# FoodSense — optional environment variables.
#
# NOTHING here is required. The full four-stage pipeline runs offline with the
# deterministic TemplateProvider for Stage 3. These keys only enable the
# optional LLM enhancement layer (`--provider anthropic|openai|ollama`).
#
# Copy to `.env` and fill in whichever you have:
#   cp .env.example .env

# Anthropic (Stage-3 provider "anthropic", model claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# OpenAI (Stage-3 provider "openai")
OPENAI_API_KEY=

# Ollama (Stage-3 provider "ollama") — local LLM server, no key needed
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Kaggle (optional, only for downloading the FULL Food.com corpus).
# Without these, the committed sample in data/samples/ is used.
KAGGLE_USERNAME=
KAGGLE_KEY=
