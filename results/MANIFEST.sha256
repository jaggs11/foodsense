#
# Every evaluated number this project reports lives in one of these files.
# Phase 6 regenerates them and diffs against this manifest, so a silent
# clobber becomes a visible one. Regenerate the manifest ONLY when a change
# has been classified and accepted.
#
# Verify:  python -c "import hashlib,pathlib;[print('OK' if hashlib.sha256(pathlib.Path(l.split('  ',1)[1].strip()).read_bytes()).hexdigest()==l.split('  ',1)[0] else 'CHANGED '+l.split('  ',1)[1].strip()) for l in open('results/MANIFEST.sha256') if not l.startswith('#') and l.strip()]"
